# 数据库配置
DATABASE_URL=sqlite:///./sparknote.db
# 生产环境建议使用Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/sparknote

# JWT配置
JWT_SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 注册验证码配置
REQUIRE_REGISTER_CAPTCHA=1
REGISTER_CAPTCHA_TTL_SECONDS=300

# AI提供商配置
# 可选: dashscope 或 openai
AI_PROVIDER=dashscope

# DashScope API密钥
DASHSCOPE_API_KEY=your-dashscope-api-key

# OpenAI API密钥 (如果使用openai作为提供商)
# OPENAI_API_KEY=your-openai-api-key
